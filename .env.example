# docker-compose 配置示例。复制为 .env 后按需修改:cp .env.example .env
# .env 含密钥,已被 .gitignore 忽略,切勿提交。

# 初始管理员口令(必填)。首次启动据此建 admin 账户。
PIPEWRIGHT_ADMIN_PASSWORD=change-me-please

# 凭据保险库主密钥:base64 编码的 32 字节。生成:
#   openssl rand -base64 32
# 留空则保险库进未配置态(加密凭据功能不可用,平台其余功能照常)。
# 重要:一旦写入凭据,务必长期保存此 key —— 更换会导致已存凭据无法解密。
PIPEWRIGHT_MASTER_KEY=

# 监听端口(宿主侧)。默认 8080。
PIPEWRIGHT_PORT=8080

# ---- 镜像:仓库 + 标签(两档只差一个后缀)----
#   latest / 0.5.0           distroless 档:最小攻击面,容器内**不能**打包镜像(构建器降级为桩)。
#   latest-docker / 0.5.0-docker   带 docker CLI:挂上宿主 /var/run/docker.sock 就能在容器内真构建/
#                            推镜像。要跑「隔离构建」还得配下面的 PIPEWRIGHT_WORK_DIR。
# 默认走阿里云 ACR(青岛,两档都有,由 .github/workflows/aliyun-image.yml 发布)。
# ghcr 只有 distroless 档(.goreleaser.yaml 发的,无 -docker 档),要用它就把下面 ACR 两行
# 换成 PIPEWRIGHT_IMAGE=ghcr.io/fuuhoo/pipewright。
PIPEWRIGHT_IMAGE=registry.cn-qingdao.aliyuncs.com/fubin/pipewright
PIPEWRIGHT_VERSION=latest
# 想在容器内打包镜像(隔离构建)就换 -docker 档:
# PIPEWRIGHT_VERSION=latest-docker

# 容器内跑「隔离构建」(script 节点在兄弟容器里执行)时才需要:一个宿主与容器**同路径**的绝对
# 目录,同时作为 TMPDIR(构建工作区落点)。留空 = 用容器 /tmp,此时容器内隔离构建不可用。
# 启用它还要放开 docker-compose.yml 里 volumes 的 ②③ 两行注释。
#
# 这一条路径同时决定**依赖缓存在哪**:容器形态下项目缓存落在
# <PIPEWRIGHT_WORK_DIR>/pipewright-project-cache/<项目ID>/,与构建工作区共用这一个宿主目录,
# 所以想让容器里的构建吃到跨运行缓存,只需把这一条映射到宿主(**别用 /data** —— 那是具名卷,
# 宿主真身在 /var/lib/docker/volumes/... 下,拿它当 docker -v 的源会在宿主根下凭空建目录)。
PIPEWRIGHT_WORK_DIR=

# 项目依赖缓存(每项目一个固定目录,流水线里零配置;Maven/npm/Go/pip/Gradle 跨运行复用)。
# 留空 = 按启动形态自动推导:进程形态落 <DB 同级>/project-cache,容器形态落上面的
# PIPEWRIGHT_WORK_DIR/pipewright-project-cache。只有想换盘(比如挪到 NVMe)才需要填,
# 填的路径在容器形态下必须是宿主与容器同路径目录。PIPEWRIGHT_NO_PROJECT_CACHE=1 可整个关掉。
# PIPEWRIGHT_PROJECT_CACHE_DIR=
# PIPEWRIGHT_NO_PROJECT_CACHE=1

# 「配置资源」(.npmrc / settings.xml 等)在宿主上的落点。构建节点会把勾上的资源只读挂进构建容器,
# 而 bind 的源路径由**宿主的 daemon** 解析:默认值 ./data 落在具名卷里,容器里读得到、宿主按这个
# 路径读不到,docker 于是报 "bind source path does not exist"(构建直接失败,根因写在日志里)。
# 要在容器内构建又用配置资源:填成宿主与容器同路径的目录 —— 用上面 PIPEWRIGHT_WORK_DIR 的子目录最省
# (共用同一条映射,不必再加 volumes 行),例如 /srv/pipewright/work/data。改之前已上传的资源要把文件
# 挪到新根下的 data/config_profiles/<资源ID>/。不在容器里构建(不挂 docker.sock)就留空不管。
# PIPEWRIGHT_DATA_DIR=

# 仅「只换二进制」形态需要(见 README 的同名小节):配合 docker-compose.binary.yml 覆盖文件,
# 指定宿主放二进制的目录(相对本 .env 所在目录,或绝对路径),它会被挂进容器 /opt/pipewright/bin。
# 注释掉即用覆盖文件里的默认值 ./bin。
# PIPEWRIGHT_BIN_DIR=/opt/pipewright-bin

# 反代后部署时填外部可访问 URL(webhook/OAuth 回跳用),如 https://ci.example.com
PIPEWRIGHT_PUBLIC_URL=

# ---- 数据库(默认 sqlite,落具名卷,无需配置)----
# 切 MySQL:取消下面三行注释,并以 --profile mysql 启动 compose。
# PIPEWRIGHT_DB_DRIVER=mysql
# PIPEWRIGHT_DB_DSN=pipewright:pipewright@tcp(mysql:3306)/pipewright?parseTime=true&charset=utf8mb4
# MYSQL_PASSWORD=pipewright
# MYSQL_ROOT_PASSWORD=rootpw
